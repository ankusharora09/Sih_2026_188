[TEMPLATE]
# Environment configuration example for SIH 2026 project

# ---------------------------------------------------
# Core services
# ---------------------------------------------------
# Database URL (PostgreSQL recommended, SQLite for quick local dev)
# Example PostgreSQL: postgresql://user:password@localhost:5432/identity_screening
# Example SQLite: sqlite:///./dev.db
DATABASE_URL=sqlite:///./dev.db

# Redis (optional) – used for rate limiting / velocity windows
#REDIS_URL=redis://localhost:6379/0

# Ollama LLM endpoint (local)
OLLAMA_HOST=http://localhost:11434

# JWT secret for dev token generation (replace with a strong secret in prod)
SECRET_KEY=change_this_to_a_strong_random_value

# Encryption key for field‑level encryption (32‑byte base64)
# Use a securely generated key in production (e.g., `openssl rand -base64 32`).
ENCRYPTION_KEY=Zm9vYmFyMTIzNDU2Nzg5MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTI=

# OAuth2/OIDC issuer URL – to be set in production
# OIDC_ISSUER_URL=https://auth.example.com

# ---------------------------------------------------
# Misc settings
# ---------------------------------------------------
# Log level (debug, info, warning, error)
LOG_LEVEL=info

# Trained forgery classifier (ResNet18 trained on the Genuine/Tampered 2 dataset)
DEEPFAKE_MODEL_PATH=models/document_forgery_gt2.pth

# Cross-case face reuse: SFace cosine gate (official SFace match gate is 0.363)
FACE_REUSE_COSINE_THRESHOLD=0.42

# Application port

# Upload configuration
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=10485760  # 10 MB
ALLOWED_EXTENSIONS=.pdf,.jpg,.jpeg,.png,.tif,.tiff
PORT=8000

# ---------------------------------------------------
# Note:
# - Do NOT commit this file with real secrets.
# - Create a matching `.env` file on the deployment host with actual values.
# - All services read configuration from environment variables.
# ---------------------------------------------------
